{
    admin off
    auto_https off
}

:8765 {
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Cache-Control "no-store"
    }

    route {
        @blocked path /oauth/admin* /oauth/realms/master* /oauth/metrics* /oauth/health*
        respond @blocked 404

        @mcp path /mcp /mcp/* /.well-known/oauth-protected-resource*
        reverse_proxy @mcp finam-mcp:8000

        @health path /healthz
        reverse_proxy @health finam-mcp:8000

        @oauth path /oauth/realms/finam* /oauth/resources/*
        reverse_proxy @oauth keycloak:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {env.MCP_PUBLIC_HOST}
            header_up X-Forwarded-Port 443
            header_up -Forwarded
            header_up -X-Forwarded-Prefix
        }

        respond 404
    }
}
